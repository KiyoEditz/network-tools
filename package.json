{
  "name": "network-tester",
  "version": "1.0.0",
  "description": "Advanced Multi-Protocol Network Tester Desktop GUI",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "mock:server": "tsx tests/mocks/server.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "tsx --test --test-force-exit tests/e2e/e2e-protocols.test.ts",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "keywords": [
    "network-tester",
    "http",
    "websocket",
    "sse",
    "grpc",
    "mqtt",
    "tcp",
    "udp",
    "webrtc"
  ],
  "author": "Antigravity",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@grpc/grpc-js": "^1.12.5",
    "@grpc/proto-loader": "^0.7.13",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-virtual": "^3.13.0",
    "clsx": "^2.1.1",
    "eventsource": "^3.0.5",
    "lowdb": "^7.0.1",
    "lucide-react": "^1.16.0",
    "mqtt": "^5.10.4",
    "protobufjs": "^7.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socks": "^2.8.4",
    "socks-proxy-agent": "^8.0.5",
    "tailwind-merge": "^3.0.1",
    "tough-cookie": "^5.1.1",
    "undici": "^7.3.0",
    "ws": "^8.18.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/eventsource": "^1.1.15",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/tough-cookie": "^4.0.5",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "aedes": "^0.51.2",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
